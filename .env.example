# ============================================================
# aws-event-platform / .env.example
# Event Registration Portal only.
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Shared Database (RDS MySQL) ─────────────────────────────
DB_HOST=your-rds-endpoint.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DB_NAME=aws_event_platform

# ── Event Registration Portal (port 5001) ───────────────────
EVENT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY
EVENT_DEBUG=false
EVENT_PORT=5001
EVENT_CORS_ORIGINS=http://your-alb-dns.ap-south-1.elb.amazonaws.com

# ── AWS Region ───────────────────────────────────────────────
AWS_REGION=ap-south-1

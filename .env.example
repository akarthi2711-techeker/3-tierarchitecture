# ============================================================
# aws-event-platform / .env.example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Shared Database (RDS MySQL) ─────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=aws_event_user
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DB_NAME=aws_event_platform

# ── Event Registration Portal (port 5001) ───────────────────
EVENT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY_1
EVENT_DEBUG=false
EVENT_PORT=5001
EVENT_CORS_ORIGINS=http://localhost:8081,https://events.example.com

# ── Student Result Portal (port 5002) ───────────────────────
RESULT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY_2
RESULT_DEBUG=false
RESULT_PORT=5002
RESULT_CORS_ORIGINS=http://localhost:8082,https://results.example.com

# ── AWS Configuration (used only for deployment scripts) ────
# Do NOT put AWS credentials in this file for production.
# Use IAM roles on EC2 instances instead.
# AWS_REGION=ap-south-1
# S3_BUCKET_NAME=aws-event-platform-assets
